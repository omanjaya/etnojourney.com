# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/etnojourney
# At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the app
BETTER_AUTH_URL=http://localhost:3000
# Optional: credentials for the seeded admin account
SEED_ADMIN_EMAIL=admin@etnojourney.id
SEED_ADMIN_PASSWORD=

# Payments (Midtrans). Leave empty in development to use the built-in payment simulator.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Email (Resend). Leave empty to print emails to the server log.
RESEND_API_KEY=
MAIL_FROM="EtnoJourney <noreply@etnojourney.id>"

# Directory for uploaded images (created automatically).
UPLOAD_DIR=./storage/uploads

# Public site URL used for canonical links, sitemap and Open Graph.
# Optional in development (defaults to BETTER_AUTH_URL); REQUIRED in production.
SITE_URL=

# Reverse proxy trust for rate limiting. Keep false unless the app is only
# reachable through your proxy. When true, the client IP is read from
# X-Forwarded-For / X-Real-IP. Either have the proxy OVERWRITE the header with
# the client address, or list the proxy IPs in TRUSTED_PROXIES so the chain is
# read right to left, skipping them. When false, per-IP limits fall back to one
# shared bucket and per-account limits still apply.
TRUST_PROXY=false
TRUSTED_PROXIES=

# Public contact details shown in the footer and structured data. Leave empty to hide.
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_ADDRESS=

# Scheduled emails (pre-trip reminders, review requests). Shared secret for
# POST /api/cron/trip-emails, sent as "Authorization: Bearer <secret>".
# At least 24 characters; generate with: openssl rand -hex 32
# Leave empty to disable the endpoint (it answers 404). See README, "Email terjadwal".
CRON_SECRET=

# Docker Compose overrides (read by compose from .env)
# DB_HOST_PORT=5544      # host port for the db container if 5432 is taken
# APP_HOST_PORT=3000     # host port for the app/dev container
# APP_URL=http://localhost:3000
